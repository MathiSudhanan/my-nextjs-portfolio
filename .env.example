# Public (safe to expose to the browser). Same values as .env.
NEXT_PUBLIC_SANITY_PROJECT_ID=lx7gopy9
NEXT_PUBLIC_SANITY_DATASET=production
# Canonical site URL used for metadata. Defaults to https://www.mathisudhanan.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix with NEXT_PUBLIC_. Set in Vercel and .env.local.
# Secret shared with the Sanity webhook that calls /api/revalidate.
SANITY_REVALIDATE_SECRET=
